# HiFiBerry Web UI nginx include file
# Include this in your existing server block with: include /etc/nginx/hifiberry-webui.conf;

# Set document root for HiFiBerry Web UI
root /usr/share/hifiberry/webui;
index index.html;

# Enable gzip compression for web assets
gzip on;
gzip_vary on;
gzip_min_length 1024;
gzip_types text/plain text/css text/xml text/javascript application/javascript application/xml+rss application/json;

# Security headers
add_header X-Frame-Options "SAMEORIGIN" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-XSS-Protection "1; mode=block" always;

# Cache hashed assets (Vite adds content hashes to filenames)
location /assets/ {
    auth_request off;  # UI/static are never gated
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
}

# Cache fonts and images
location ~* \.(png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
    auth_request off;  # UI/static are never gated
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
}

# Unknown API paths get a 404, not the SPA fallback below. Every service claims a
# longer /api/<service>/ prefix, so only paths no service serves land here; with
# index.html and a 200 a client probing for an API path cannot tell it is missing.
location /api/ {
    auth_request off;  # a path that does not exist has nothing to gate
    default_type application/json;
    return 404 '{"error":"not found"}';
}

# SPA fallback - serve index.html for all unmatched routes
# index.html must not be cached so the browser always gets the latest asset references
location / {
    auth_request off;  # UI/static are never gated
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
}
